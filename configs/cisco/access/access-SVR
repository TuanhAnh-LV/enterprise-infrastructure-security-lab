! Cisco IOS-style lab reference template
! Interface names and feature syntax vary by virtual image and release.
! Replace placeholders only in a private working copy.

hostname ACCESS-SERVER
no ip domain-lookup
ip domain name lvta-lab.test
service timestamps log datetime msec localtime show-timezone
spanning-tree mode rapid-pvst

username admin privilege 15 secret password
crypto key generate rsa modulus 2048
ip ssh version 2
line vty 0 4
 transport input ssh
 login local
 exec-timeout 10 0
!
vlan 10
 name MGMT
vlan 20
 name SERVER
vlan 80
 name SOC
vlan 999
 name NATIVE-BLACKHOLE
!
! ---------------------- Access-to-core trunk --------------------------------
interface Ethernet0/0
 description TO-CORE01
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 10,20,80,999
 switchport nonegotiate
 spanning-tree guard loop
 no shutdown
!
interface Ethernet0/1
 description TO-CORE02
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 10,20,80,999
 switchport nonegotiate
 spanning-tree guard loop
 no shutdown
!
! ---------------------- Endpoint-facing access port --------------------------
interface Ethernet0/2
 description DC_DNS_DHCP_SERVER
 switchport mode access
 switchport access vlan 20
 spanning-tree portfast
 spanning-tree bpduguard enable
 no shutdown
!
interface e0/3
 description SOC_SERVER
 switchport mode access
 switchport access vlan 80
 spanning-tree portfast
 spanning-tree bpduguard enable
 no shutdown
!
interface range e1/0-3
 description UNUSED
 switchport mode access
 switchport access vlan 999
 shutdown
!
interface Vlan10
 description SWITCH-MANAGEMENT
 ip address 10.60.20.23 255.255.255.0
 no shutdown
!
ip defaut-gateway 10.60.10.1
!
end
write memory

! Validation:
! show vlan brief
! show interfaces trunk
